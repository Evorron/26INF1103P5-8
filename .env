GEMINI_MODEL=gemini-3.7-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite
GEMINI_MAX_RETRIES=2
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/interactions
